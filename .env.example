# Development needs no configuration. Production requires all three values.
APP_ORIGIN=https://sendfold.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SETUP_TOKEN=replace-with-a-different-random-secret
# Node/VPS only; optional:
# DATA_DIR=/var/lib/sendfold
# HOST=0.0.0.0
# PORT=8787
